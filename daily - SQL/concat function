use sakila;

-- functions:-
-- it is a block of code => code reusable and readable
-- built-in function and user defined 
-- pre-defined => scaler functions
-- scaler => applied for each row and result will be given for each row  
-- string(character) , number , date related function
-- string related function (today at 3rd feb)

select first_name, lower(first_name), last_name, upper(last_name) from actor;

-- concat "hey" + "hello"  ->   concat("hey","hello") 
select first_name , last_name , concat(first_name, last_name) from actor;

-- var = "regex"               var +"software"
select first_name, last_name, concat(first_name, " ", last_name) from actor;

-- extract me all the data first_name + last_name = 'EDCHASE'
select * from actor where concat(first_name + last_name) = 'EDCHASE';

-- combine where concat(col1, col2) = 'edchase'
select * ,concat(first_name , last_name) from actor
WHERE concat(first_name , last_name) like '%A%A%';


-- concat with a seperator
select first_name, last_name, concat('MR','-',first_name, last_name) ,
concat_ws('-','MR',first_name, last_name) from actor;


-- substr => extract kuch portion ko (extaract data basis of position)
select first_name , last_name , substr(last_name,5) from actor;

select first_name , last_name , substr(last_name,-2) from actor;

select first_name , last_name , substr(last_name,1,4) from actor;

select first_name , last_name , substr(last_name,1,6) from actor;

select first_name , last_name , substr(last_name,-3,2) from actor;


select * from actor
where first_name like 'A%' or first_name like 'E%';

select * , substr(first_name,1,1) from actor
where substr(first_name,1,1)='A' or substr(first_name,1,1)='E';


select first_name, replace( first_name, 'A','') from actor;






